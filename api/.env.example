# ── Required — app will refuse to start without these ─────────────
PROJECT_ID=your-gcp-project-id
AGENT_ID=your-dialogflow-cx-agent-id
DATA_STORE_ID=your-vertex-ai-datastore-id

# ── Authentication — set a strong random string in production ──────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=replace-with-a-strong-secret-key

# ── Webhook Authentication ────────────────────────────────────────
# Find these in the Dialogflow CX console under your agent settings
# DIALOGFLOW_SERVICE_ACCOUNT: email of the service account that calls the webhook
#   e.g., dialogflow-cx@your-project.iam.gserviceaccount.com
DIALOGFLOW_SERVICE_ACCOUNT=

# WEBHOOK_AUDIENCE: usually your Cloud Run service URL (optional)
#   e.g., https://my-service-abcd1234-uc.a.run.app
# Leave blank to skip audience validation on OIDC tokens
WEBHOOK_AUDIENCE=

# ── Dialogflow ────────────────────────────────────────────────────
LOCATION=asia-south1
DIALOGFLOW_TIMEOUT=15

# ── Rate Limiting ─────────────────────────────────────────────────
# Requests per window on /chat endpoint
RATE_LIMIT_REQUESTS=30
# Window size in seconds
RATE_LIMIT_WINDOW=60

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
